# Copy this file to .env.local for local development, and set the same
# variables in your hosting provider's dashboard (e.g. Vercel → Project →
# Settings → Environment Variables) for production. See README → "Wiring up
# the form" for the full setup steps.

# Required for the booking form to actually email enquiries. Get one free at
# https://resend.com — without it, enquiries are only logged to the server
# console.
RESEND_API_KEY=

# Optional: the "from" address enquiry emails are sent from. Must be on a
# domain you've verified in Resend. Leave unset to use Resend's shared
# onboarding@resend.dev sender, which works immediately but is less
# polished (and some inboxes are more likely to flag it as unfamiliar).
BOOKING_FROM_EMAIL=
